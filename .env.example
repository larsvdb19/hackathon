# Copy to .env (never commit .env). The API key is a secret; the project id is not.
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-00-6fe25c47697f
GOOGLE_CLOUD_LOCATION=europe-west1
# Option A: API key
GOOGLE_API_KEY=
# Option B: leave the key empty and use `gcloud auth application-default login`
GEMINI_MODEL=gemini-2.5-flash
